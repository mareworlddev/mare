# ============================================================
# Agente Mare — variáveis de ambiente
# Copie para .env.local (dev) ou cadastre na Vercel (produção).
# Chaves NEXT_PUBLIC_* voam para o navegador — nunca coloque segredo nelas.
# ============================================================

# URL pública da aplicação (usada em links e metadados)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
# Modelos de IA (tudo server-side; o navegador nunca vê estas chaves)
# ------------------------------------------------------------
# Pollinations: GPT-5 Nano, GPT-OSS 20B (escritor do mare-nimble) e imagem
POLLI_KEY=sua_chave_pollinations

# Cerebras: orquestrador do mare-nimble (qwen-3-8-27b? mantém o atual)
CEREBRAS_API_KEY=sua_chave_cerebras

# FireCrawl: pesquisa e leitura de páginas do mare-nimble
FIRE_CRAWLER_API_KEY=sua_chave_firecrawl

# ------------------------------------------------------------
# Supabase — auth (Google), banco dos projetos e storage do estado
# Dashboard → Project Settings → API
# ------------------------------------------------------------
# URL do projeto (https://SEU-PROJETO.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (antes chamada de anon key). Pública por design: a proteção
# de verdade é a RLS (supabase/migrations/0002_security.sql) e a política do
# bucket de estado (0003_storage.sql).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------
# Vercel (logado automaticamente pelo ambiente; listado por clareza)
# VERCEL, VERCEL_ENV, VERCEL_URL — definidas pela plataforma.
# Na Vercel SEM Supabase configurado, o app fica em modo fail-closed
# (503 nas rotas de IA/estado) por segurança. Os arquivos (histórico
# sincronizado) ficam no bucket privado `mare-state` do próprio Supabase.
# ------------------------------------------------------------
