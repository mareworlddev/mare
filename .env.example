# ============================================================
# Agente Mare — variáveis de ambiente
# ============================================================

# URL pública da aplicação (usada em links e metadados)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
# Modelos
# ------------------------------------------------------------
# Pollinations: GPT-5 Nano, GPT-OSS 20B (escritor do mare-nimble) e imagem
POLLI_KEY=sua_chave_pollinations

# Cerebras: orquestrador do mare-nimble (qwen-3.8-27b)
CEREBRAS_API_KEY=sua_chave_cerebras

# FireCrawl: pesquisa e leitura de páginas do mare-nimble
FIRE_CRAWLER_API_KEY=sua_chave_firecrawl

# ------------------------------------------------------------
# Cloudflare R2 (opcional)
# Sem essas variáveis o histórico fica apenas no navegador.
# ------------------------------------------------------------
R2_ENDPOINT=https://seu_conta.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=seu_access_key
R2_SECRET_ACCESS_KEY=seu_secret_key
R2_BUCKET_NAME=seu_bucket
R2_PUBLIC_BASE_URL=https://seu_dominio_publico
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://seu_dominio_publico
